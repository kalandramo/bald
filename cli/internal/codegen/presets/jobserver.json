{
  "meta": {
    "name": "my-jobserver",
    "module": "example.com/my-jobserver",
    "desc": "jobserver 预设：单 worker 角色（gRPC + cron 周期任务 + asynq 异步任务）。改 meta.name/module 后，运行 bald gen app --spec appspec.json",
    "roles": [
      {
        "name": "worker",
        "domains": [],
        "server": {
          "grpc": true,
          "grpcAddr": ":9091",
          "cron": true,
          "asynq": true
        }
      }
    ]
  },
  "bootstrap": {
    "app": {
      "version": "v0.1.0",
      "stopTimeout": "15s"
    },
    "logger": {
      "backends": [
        {
          "type": "slog",
          "slog": {
            "level": "info",
            "format": "console",
            "outputPath": "stdout"
          }
        }
      ]
    },
    "server": {
      "cron": {
        "location": "Asia/Shanghai"
      },
      "asynq": {
        "redisAddress": "127.0.0.1:6379"
      }
    }
  },
  "domains": []
}
