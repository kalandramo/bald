digraph bald_modules {
    rankdir=TB;
    node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f2f5fa"];
    edge [fontname="Helvetica", fontsize=9, color="#5b6b7f", arrowsize=0.6];
    graph [fontname="Helvetica", fontsize=12, ranksep=0.55, nodesep=0.35, labelloc=t,
           label="bald 模块拓扑（4 个 go.mod）— 2026-11-28 扁平化重核（原 95-module 图作废；\
包级分层唯一事实源 = 仓根 .arch.json，六层互斥由 internal/archgate 原生门禁执行）\n\
实线 = 按已发布 tag 的 require；虚线 = 开发期本地 replace（发版前移除或仅联调环境生效）\n\
（已用 dot -Tsvg 渲染校验，graphviz 16.x）"];

    subgraph cluster_libs {
        label="库与契约（发布单元）";
        style=rounded; color="#9aa7b8";
        root [label="根模块 github.com/kalandramo/bald\n全部库包：pkg/appkit、transport、cache、\nregistry、broker、oss、encoding、contrib、\nbootstrap(config)、bconfig、log…（v0.57.0 线）",
              fillcolor="#e8f0e0", tooltip="单一依赖面：go get github.com/kalandramo/bald@vX.Y.Z"];
        bconf [label="bconf github.com/kalandramo/bald/bconf\n契约 proto 单一真相源\n（bconf/v0.31.1 独立线）", fillcolor="#e8f0e0"];
        cobramcp [label="cobramcp github.com/kalandramo/bald/cobramcp\nCobra → MCP 工具桥\nexamples 已并入本 module（v0.4.1 线）"];
    }

    cli [label="cli github.com/kalandramo/bald/cli\n官方 CLI cmd/bald（gen/release/convention）\ngo.mod 零 replace（风险评审 §3.4）\n（cli/v0.18.1 线）", fillcolor="#fdeeda"];

    subgraph cluster_consumers {
        label="消费者（不在发布线内）";
        style=rounded; color="#9aa7b8";
        example [label="_example/bald\n最小示例（独立 module）"];
        admin [label="bald-admin/backend（外部仓）\nbald 主消费者：direct require 3 行\n（bald + bconf + cli）"];
    }

    root -> bconf [label="require v0.31.1\n（开发期 replace ./bconf 联调 proto 变更）", style=dashed];
    cobramcp -> root [label="require v0.56.1\n（开发期 replace ../ 跟随根新符号）", style=dashed];
    cli -> bconf [label="require bconf/v0.30.0（已发布）"];
    cli -> cobramcp [label="require cobramcp/v0.4.1（已发布）"];
    example -> root;
    example -> bconf [style=invis];
    admin -> root [label="目标 require v0.57.0\n（联调期 replace ../../bald）", style=dashed];
    admin -> bconf;
    admin -> cli [label="admin 仓 tools 包 blank import 钉版本\n（task gen:* 用 go run）"];
}
