{
  "meta": {
    "name": "demo-svc",
    "module": "github.com/you/demo-svc",
    "desc": "AppSpec 方言驱动生成的演示服务"
  },
  "bootstrap": {
    "server": {
      "http": {"addr": ":8080"},
      "grpc": {"addr": ":9090"}
    },
    "audit": {
      "backends": ["log", "store"]
    }
  },
  "components": [
    {"kind": "heartbeat", "name": "demo.heartbeat", "configPrefix": "demo"}
  ],
  "capability": {
    "provides": ["demo.api", "db"],
    "requires": [
      {"component": "audit.store", "caps": ["db"]}
    ]
  },
  "bundle": {"normalized": true}
}
