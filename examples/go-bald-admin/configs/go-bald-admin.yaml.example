server:
  http: { addr: ":8080" }
  grpc:  { addr: ":9090" }
gateway: { addr: ":8081" }
log: { level: "info", format: "json" }
audit: { backends: "store,stream" }   # Redis 可用才含 stream

# ---- T0 新增：真实服务依赖（云端地址由用户填写）----
database:
  sql:
    driver: "postgres"
    source: "host=<PG_HOST> port=5432 user=<PG_USER> password=<PG_PASSWORD> dbname=<PG_DB> sslmode=disable"
    migrate: true
cache:
  redis:
    addr: "<REDIS_HOST>:6379"
    password: "<REDIS_PASSWORD>"   # 无密码留空
    db: 0
storage:
  minio:
    endpoint: "<MINIO_HOST>:9000"
    access_key: "<MINIO_ACCESS_KEY>"
    secret_key: "<MINIO_SECRET_KEY>"
    use_ssl: false
registry:
  type: "nacos"
  nacos:
    server_addrs: ["<NACOS_HOST>:8848"]
    # namespace 必须填 Nacos「命名空间 ID」（UUID）而非显示名——ID 不匹配时注册
    # 会被服务端拒绝/落孤儿空间（nacos-sdk-go v2 静默吞 403，仅 WARN）。
    namespace: "<NAMESPACE_ID>"
    group: "<GROUP>"               # 留空走 SDK 默认 DEFAULT_GROUP
    # 服务端开启鉴权时必填（gRPC 连接 setup 时登录；未开启可留空）。
    username: "<NACOS_USERNAME>"
    password: "<NACOS_PASSWORD>"

# ---- 配置中心（契约 config 段 → appkit 配置层）----
# 层优先级低于本地文件/env/flag：远程只补充本地未定义的键（本地值始终胜出）；
# dataId 内容变更经 nacos ListenConfig 推送热更新（Watch=true）。
config:
  nacos:
    server_addrs: ["<NACOS_ADDR>:8848"]
    namespace: "<NAMESPACE_ID>"
    group: "DEFAULT_GROUP"
    data_id: "go-bald-admin.yaml"
    format: "yaml"
    username: "<NACOS_USERNAME>"   # 服务端开启鉴权时必填
    password: "<NACOS_PASSWORD>"

# ---- T9 新增：可观测性（tracer/metrics 契约段）----
# tracer.otlp.endpoint 空则 trace 走核心 no-op（零配置可运行）。
tracer:
  type: "otlp"
  otlp:
    endpoint: "<OTLP_HOST>:4318"   # 裸地址默认 insecure；https:// 前缀走 TLS
    insecure: true
    # headers:                     # 远端 APM 鉴权（如 Grafana Cloud）
    #   Authorization: "Bearer <token>"
    sampler: "always_on"           # always_on / always_off / trace_id_ratio / parent_based
    sample_ratio: 1.0              # 仅 trace_id_ratio 生效
metrics:
  # prometheus 暴露端点总是挂载（供本地抓取），otlp 段非空则叠加直推。
  type: "otlp"
  prometheus: { addr: ":9091", path: "/metrics" }
  otlp:
    endpoint: "<OTLP_HOST>:4318"
    insecure: true
    push_interval: 15              # 秒

# ---- 业务自持段（storage.minio 契约无 bucket 字段，file 模块自持）----
file:
  bucket: "bald-admin"